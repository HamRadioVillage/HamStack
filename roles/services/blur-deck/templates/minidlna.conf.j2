media_dir=V,{{ hamstack_blur_deck_media_dir }}
friendly_name={{ hamstack_blur_deck_dlna_friendly_name }}
db_dir=/var/cache/minidlna
log_dir=/var/log/minidlna
inotify={{ 'yes' if hamstack_blur_deck_inotify else 'no' }}
notify_interval=60
{% if hamstack_blur_deck_network_interfaces | length > 0 %}
network_interface={{ hamstack_blur_deck_network_interfaces | join(',') }}
{% endif %}
{% for key, value in hamstack_blur_deck_extra_config | dictsort %}
{{ key }}={{ value }}
{% endfor %}

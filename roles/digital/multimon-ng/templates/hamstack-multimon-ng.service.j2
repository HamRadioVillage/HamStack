[Unit]
Description=HamStack multimon-ng decoder
After=sound.target network.target

[Service]
Type=simple
User={{ hamstack_multimon_ng_user }}
Group={{ hamstack_multimon_ng_group }}
ExecStart=/usr/local/bin/hamstack-multimon-ng
Restart=on-failure
RestartSec=3
StandardOutput=append:{{ hamstack_multimon_ng_output_file }}
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths={{ hamstack_multimon_ng_output_file }}

[Install]
WantedBy=multi-user.target

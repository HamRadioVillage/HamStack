; =============================================================
; HamStack-managed LinBPQ node configuration
; Generated by Ansible. Local edits will be overwritten.
; =============================================================
{% if hamstack_linbpq_bbs_enabled %}
LINMAIL
{% endif %}
NODECALL={{ _hamstack_linbpq_node_callsign }}
NODEALIAS={{ hamstack_linbpq_node_alias }}
{% if hamstack_linbpq_locator | length > 0 %}LOCATOR={{ hamstack_linbpq_locator }}
{% endif %}
{% for key, value in hamstack_linbpq_node_options.items() %}{{ key }}={{ value }}
{% endfor %}
{% for key, value in hamstack_linbpq_extra_settings.items() %}{{ key }}={{ value }}
{% endfor %}
IDINTERVAL={{ hamstack_linbpq_id_interval }}
BTINTERVAL={{ hamstack_linbpq_beacon_interval }}

IDMSG:
{% if hamstack_linbpq_id_message | length > 0 %}{{ hamstack_linbpq_id_message }}{% else %}{{ _hamstack_linbpq_node_callsign }} {{ hamstack_linbpq_node_alias }} - HamStack Packet Node{% endif %}
***

BTEXT:
{% if hamstack_linbpq_beacon_text | length > 0 %}{{ hamstack_linbpq_beacon_text }}{% else %}{{ _hamstack_linbpq_node_callsign }} {{ hamstack_linbpq_node_alias }} | HamStack Packet Node{% if hamstack_linbpq_bbs_enabled %} | BBS {{ _hamstack_linbpq_bbs_callsign }}{% endif %}{% endif %}
***

FULL_CTEXT={{ 1 if hamstack_linbpq_full_connect_text else 0 }}
CTEXT:
{% if hamstack_linbpq_connect_text | length > 0 %}{{ hamstack_linbpq_connect_text }}{% else %}Welcome to {{ _hamstack_linbpq_node_callsign }} / {{ hamstack_linbpq_node_alias }}.
{% if hamstack_linbpq_bbs_enabled %}Type {{ hamstack_linbpq_bbs_application_command }} to enter the bulletin board.
{% endif %}Type PORTS to list interfaces.
Type INFO for station information.
Type ? for node commands.{% endif %}
***

INFOMSG:
{% if hamstack_linbpq_info_message | length > 0 %}{{ hamstack_linbpq_info_message }}{% else %}HamStack-managed LinBPQ packet node.
Graywolf provides the modem/PTT layer; LinBPQ connects to KISS TCP endpoints defined in inventory.{% endif %}
***

{% for port in hamstack_linbpq_ports %}
PORT
 PORTNUM={{ port.portnum }}
 ID={{ port.id | default('HamStack KISS ' ~ port.portnum) }}
 TYPE={{ port.type | default('ASYNC') }}
 PROTOCOL={{ port.protocol | default('KISS') }}
 KISSOPTIONS={{ port.kiss_options | default(hamstack_linbpq_kiss_options) }}
 IPADDR={{ port.kiss_host | default(hamstack_linbpq_port_defaults.kiss_host) }}
 TCPPORT={{ port.kiss_port }}
 CHANNEL={{ port.channel | default(hamstack_linbpq_port_defaults.channel) }}
 FULLDUP={{ port.fulldup | default(hamstack_linbpq_port_defaults.fulldup) }}
 QUALITY={{ port.quality | default(hamstack_linbpq_port_defaults.quality) }}
 PERSIST={{ port.persist | default(hamstack_linbpq_port_defaults.persist) }}
 SLOTTIME={{ port.slottime | default(hamstack_linbpq_port_defaults.slottime) }}
 TXDELAY={{ port.txdelay | default(hamstack_linbpq_port_defaults.txdelay) }}
 TXTAIL={{ port.txtail | default(hamstack_linbpq_port_defaults.txtail) }}
 FRACK={{ port.frack | default(hamstack_linbpq_port_defaults.frack) }}
 RESPTIME={{ port.resptime | default(hamstack_linbpq_port_defaults.resptime) }}
 RETRIES={{ port.retries | default(hamstack_linbpq_port_defaults.retries) }}
 MAXFRAME={{ port.maxframe | default(hamstack_linbpq_port_defaults.maxframe) }}
 PACLEN={{ port.paclen | default(hamstack_linbpq_port_defaults.paclen) }}
 DIGIFLAG={{ port.digiflag | default(hamstack_linbpq_port_defaults.digiflag) }}
 USERS={{ port.users | default(hamstack_linbpq_port_defaults.users) }}
{% for key, value in port.extra | default({}) | dictsort %} {{ key }}={{ value }}
{% endfor %}ENDPORT

{% endfor %}
{% if hamstack_linbpq_telnet_enabled or hamstack_linbpq_web_enabled %}
PORT
 PORTNUM={{ hamstack_linbpq_ip_service_portnum }}
 ID={{ hamstack_linbpq_ip_service_id }}
 DRIVER=TELNET
 QUALITY={{ hamstack_linbpq_ip_service_quality }}
 CONFIG
  LOGGING={{ 1 if hamstack_linbpq_telnet_logging else 0 }}
  DisconnectOnClose={{ 1 if hamstack_linbpq_disconnect_on_close else 0 }}
  SECURETELNET={{ 1 if hamstack_linbpq_secure_telnet else 0 }}
  IPV4={{ 1 if hamstack_linbpq_ipv4_enabled else 0 }}
  IPV6={{ 1 if hamstack_linbpq_ipv6_enabled else 0 }}
{% if hamstack_linbpq_telnet_enabled %}  TCPPORT={{ hamstack_linbpq_telnet_port }}
  FBBPORT={{ hamstack_linbpq_fbb_port }}
{% endif %}{% if hamstack_linbpq_web_enabled %}  HTTPPORT={{ hamstack_linbpq_web_port }}
{% endif %}  LOGINPROMPT={{ hamstack_linbpq_login_prompt }}
  PASSWORDPROMPT={{ hamstack_linbpq_password_prompt }}
  MAXSESSIONS={{ hamstack_linbpq_max_sessions }}
{% if hamstack_linbpq_telnet_ctext | length > 0 %}  CTEXT={{ hamstack_linbpq_telnet_ctext | replace('\n', '\\n') }}
{% endif %}{% for user in hamstack_linbpq_telnet_users %}  USER={{ user.username }},{{ user.password }},{{ user.callsign | default(user.username | upper) }},,{{ 'SYSOP' if user.sysop | default(false) else '' }}
{% endfor %}{% if hamstack_linbpq_anonymous_enabled %}  USER={{ hamstack_linbpq_anonymous_username }},{{ hamstack_linbpq_anonymous_password }}
{% endif %}ENDPORT

{% endif %}
{% if hamstack_linbpq_bbs_enabled %}APPLICATION {{ hamstack_linbpq_bbs_application_number }},{{ hamstack_linbpq_bbs_application_command }},,{{ _hamstack_linbpq_bbs_callsign }},{{ hamstack_linbpq_bbs_alias }},{{ hamstack_linbpq_bbs_application_quality }}
{% endif %}{% for app in hamstack_linbpq_applications %}APPLICATION {{ app.number }},{{ app.command }}{% if app.params is defined and app.params | length > 0 %},{{ app.params }}{% endif %}
{% endfor %}
{% if hamstack_linbpq_raw_config_append | length > 0 %}
; ---- operator-supplied additional configuration ----
{{ hamstack_linbpq_raw_config_append }}
{% endif %}

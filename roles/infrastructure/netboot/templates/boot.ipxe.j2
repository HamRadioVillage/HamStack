#!ipxe
set menu-timeout 8000
set submenu-timeout ${menu-timeout}
imgtrust --permanent || goto failed

:start
menu {{ hamstack_netboot_menu_title }}
{% for entry in hamstack_netboot_entries %}
item {{ entry.id }} {{ entry.label | default(entry.id) }}
{% endfor %}
item shell iPXE shell
item reboot Reboot
choose --timeout ${menu-timeout} --default shell selected || goto shell
goto ${selected}

{% for entry in hamstack_netboot_entries %}
:{{ entry.id }}
{% if entry.chain is defined %}
imgfetch --name chain-{{ entry.id }} {{ entry.chain }} || goto failed
imgverify chain-{{ entry.id }} {{ entry.chain_signature }} || goto failed
imgexec chain-{{ entry.id }} || goto failed
{% else %}
kernel --name kernel-{{ entry.id }} {{ entry.kernel }}{% if entry.args is defined and entry.args | length > 0 %} {{ entry.args }}{% endif %} || goto failed
imgverify kernel-{{ entry.id }} {{ entry.kernel_signature }} || goto failed
{% if entry.initrd is defined and entry.initrd | length > 0 %}
initrd --name initrd-{{ entry.id }} {{ entry.initrd }} || goto failed
imgverify initrd-{{ entry.id }} {{ entry.initrd_signature }} || goto failed
{% endif %}
boot || goto failed
{% endif %}

{% endfor %}
:shell
shell
exit

:failed
echo Boot failed. Dropping to shell.
shell
exit

:reboot
reboot

ADMIN_USERNAME={{ hamstack_dcdash_admin_username }}
ADMIN_PASSWORD={{ vault_hamstack_dcdash_admin_password }}
DB_PATH={{ hamstack_dcdash_db_path }}
REPORTS_DIR={{ hamstack_dcdash_reports_dir }}
BACKUP_DIR={{ hamstack_dcdash_backup_dir }}
CERT_FILE={{ hamstack_dcdash_cert_file }}
KEY_FILE={{ hamstack_dcdash_key_file }}
DCDASH_HOST={{ hamstack_dcdash_bind_address }}
PORT={{ hamstack_dcdash_port }}
REVERSE_PROXY={{ 'true' if hamstack_dcdash_reverse_proxy else 'false' }}
PROXY_HOPS={{ hamstack_dcdash_proxy_hops }}
{% if hamstack_dcdash_max_fox_rule_points is not none %}
MAX_FOX_RULE_POINTS={{ hamstack_dcdash_max_fox_rule_points }}
{% endif %}
{% for key, value in hamstack_dcdash_extra_environment | dictsort %}
{{ key }}={{ value }}
{% endfor %}
